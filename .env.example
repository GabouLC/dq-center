# dq-center: variables de entorno. Plantilla SIN valores reales.
#
# Cómo usarla:
#   - Copia este archivo a .env (git lo ignora) y completa solo lo que necesites. Nunca subas el .env.
#   - La API, los scripts y el CLI de GCP leen el ENTORNO del proceso, no el archivo .env.
#     Defínelas como variables de usuario de Windows, o cárgalas en la sesión de PowerShell:
#       Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=.' } | ForEach-Object { $n, $v = $_ -split '=', 2; Set-Item "Env:$n" $v }
#     (solo carga las líneas con valor; las que empiezan con # son opcionales y ya tienen un valor por defecto).
#   - Las variables VITE_* las lee el portal al arrancar: van en web/.env.local, que también se ignora.
#   - Las credenciales de GCP no van aquí: salen de las credenciales de aplicación de Google
#     (por ejemplo, gcloud auth application-default login).
#   - Para pruebas locales (pytest y portal en modo demo) no hace falta definir nada.

# ── API (python -m dqc.api) ─────────────────────────────────────────────────────

# local = DuckDB y configuración en JSON (por defecto); gcp = BigQuery y Firestore.
# DQC_MODO=local

# Secreto que firma las sesiones. SECRETO: obligatorio en Cloud Run (viene de Secret Manager);
# en local, si falta, la API genera uno en data/. Para crear uno:
#   py -3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
DQC_SECRETO=

# clave = correo y contraseña (por defecto); firebase = además, inicio de sesión con Google.
# DQC_AUTH=clave

# 1 en modo local: las cuentas *@demo.local entran con DQC_CLAVE_DEMO. Prohibido en Cloud Run.
# DQC_DEMO=1

# Contraseña de las cuentas demo. Si no la defines, la API usa la de demostración documentada
# en el README. Si pones otra, que no sea una clave que uses en otro sitio.
# DQC_CLAVE_DEMO=

# Correos con rol admin en modo local, separados por coma. A cada uno sin contraseña, la API le
# imprime una temporal al arrancar.
# DQC_ADMINS=

# Archivo DuckDB del modo local.
# DQC_DB=data/dq.duckdb

# Carpeta de configuración (reglas, contratos y homologación).
# DQC_CONFIG=config

# Archivo JSON con la configuración local del portal (usuarios, glosario, auditoría).
# DQC_CONFIG_LOCAL=data/config_local.json

# 1 en modo local: las entregas pendientes de data/landing llegan solas; 0 lo apaga.
# DQC_EN_VIVO=1

# Segundos entre un archivo y el siguiente en la simulación en vivo.
# DQC_EN_VIVO_SEGUNDOS=20

# Orígenes permitidos por CORS, separados por coma (por defecto http://localhost:5173).
# DQC_ORIGENES=

# ── GCP (modo gcp, python -m dqc.gcp y scripts/evidencia_bigquery.py) ───────────

# Proyecto de GCP (BigQuery, Firestore y, con DQC_AUTH=firebase, Firebase).
DQC_PROYECTO=

# 1 si el proyecto no tiene facturación (ADR 0008): tablas agrupadas por corte.
# DQC_SANDBOX=1

# Cloud Run Job que lanza las corridas a demanda, con el formato
# projects/<proyecto>/locations/<región>/jobs/<job>. Vacío: corren dentro de la API.
# DQC_JOB=

# ── Portal en desarrollo (web/) ─────────────────────────────────────────────────

# Dirección de la API local a la que el proxy de Vite envía /api y /health.
# Lo lee web/vite.config.ts del entorno del proceso (no de web/.env.local).
# DQC_API=http://127.0.0.1:8000

# Dirección base de la API cuando el portal se sirve aparte (vacío = mismo origen, por el proxy).
# VITE_API_URL=

# Inicio de sesión con Google (solo con DQC_AUTH=firebase). Son la configuración web de la app
# de Firebase; sin VITE_FIREBASE_API_KEY, el portal funciona con correo y contraseña.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

# ── Jira del curso (scripts/jira_sync.py) ───────────────────────────────────────

# Dirección del sitio de Jira Cloud, por ejemplo https://<sitio>.atlassian.net
JIRA_SITE=
# Correo de la cuenta de Atlassian con la que se creó el token.
JIRA_EMAIL=
# SECRETO: token de API de Atlassian (id.atlassian.com > Seguridad > Tokens de API).
# Va en una variable de usuario de Windows, nunca en un archivo del repo.
JIRA_API_TOKEN=
